{
  "name": "بوت نواقص صيدلية عسكر",
  "short_name": "نواقص عربي",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "asker-nawaqes-arabic.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbf8f8",
  "theme_color": "#7d1028",
  "icons": [
    {
      "src": "icons/arabic-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/arabic-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "ar/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".xlsx",
            ".xls",
            ".csv",
            "text/csv",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.ms-excel"
          ]
        }
      ]
    }
  }
}
