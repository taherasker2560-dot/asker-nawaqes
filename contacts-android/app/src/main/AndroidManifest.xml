<?xml version="1.0" encoding="utf-8"?>
<!-- «دفتر الأرقام» (owner 2026-11-20, option «أ»: «نخلي حفظ الارقام في تطبيقنا ونعمله اوبشن يتخزن بشكل تلقائي في سجل ارقام الهاتف وجوجل»):
     the owner's phone app that keeps his phone's contacts (and so his Google contacts) in step with the system's number book.
     - the numbers saved in the system (ar_contacts, typed in «طلب مش موجود») are written into the phone's contacts;
     - every 10 days it reads the phone's contacts and sends them to the system (the laptop merges them; the new ones come closed to the staff).
     It talks to the system's own server only, with this phone's own key (put here by the system's «اربط التطبيق» button). No ads, no outside libraries. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- the app's own screen: is it linked, is the permission given, when did it last talk to the system, and «زامن دلوقتي» -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the system's «اربط التطبيق» button (askercontacts://link?k=<this phone's key>): asks him once, then keeps the key.
             The server's address is NOT taken from the link, so no page can send this phone's contacts anywhere else. -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="askercontacts" android:host="link" />
            </intent-filter>
        </activity>

        <!-- every 3 hours (the system decides the hour): numbers waiting for the phone are written; every 10 days the phone's contacts go to the system -->
        <service
            android:name=".SyncJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
